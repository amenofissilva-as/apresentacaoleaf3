<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Identity Cartography</title>

    <style>
        body{
            margin:0;
            background:#222;
            color:white;
            font-family:Arial,Helvetica,sans-serif;
        }

        header{
            background:#1565C0;
            padding:20px;
            text-align:center;
        }

        h1{
            margin:0;
        }

        iframe{
            width:100%;
            height:92vh;
            border:none;
        }

        .btn{
            display:inline-block;
            margin-top:15px;
            padding:12px 25px;
            background:#00C853;
            color:white;
            text-decoration:none;
            border-radius:8px;
            font-weight:bold;
        }

        .btn:hover{
            background:#009624;
        }

    </style>

</head>

<body>

<header>

<h1>Identity Cartography</h1>

<p>Visualização Online do Documento</p>

<a class="btn" href="Identity_cartography.pdf" target="_blank">
Abrir PDF em nova guia
</a>

</header>

